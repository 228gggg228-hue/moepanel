                        if e.manual and e.uid then
                            HW.mfail = HW.mfail or {}
                            HW.mfail[e.uid] = (HW.mfail[e.uid] or 0) + 1
                            if HW.mfail[e.uid] >= 3 then HW.manual[e.uid] = nil end
                        end
                        return
                    end
                    local manualUid = e.manual and e.uid or nil
                    for _ = 1, 3 do
                        if not alive(H) then return end
                        local r = hrp()
                        if r then r.CFrame = CFrame.new(STAGE); zero(r) end
                        task.wait(0.03)
                    end
                    print("[KakaxiHW] picked up " .. tostring(e.name) .. " (manual=" .. tostring(e.manual == true) .. "), carrying=" .. tostring(carrying()))
                    local okDrop = dropRegrab(H, e.uid)
                    local before = candyNow()
                    if okDrop then
                        glide(H, BANKSPOT, 0.12)
                        for _ = 1, 10 do
                            task.wait(0.1)
                            if candyNow() > before then break end
                        end
                    end
                    local after = candyNow()
                    local banked = okDrop and after > before
                    print(("[KakaxiHW] result: regrab=%s candy %s -> %s banked=%s carryingNow=%s"):format(tostring(okDrop), tostring(before), tostring(after), tostring(banked), tostring(carrying())))
                    if banked then
                        HW.stats.delivered += 1
                        if manualUid then HW.manual[manualUid] = nil; if HW.mfail then HW.mfail[manualUid] = nil end end
                    else
                        HW.stats.fails += 1
                        HW.lastErr = okDrop and "Egg not banked" or "Drop/regrab failed"
                        if manualUid then
                            -- ручное яйцо пробуем ещё раз (до 3 раз), если оно ещё лежит в измерении
                            HW.mfail = HW.mfail or {}
                            HW.mfail[manualUid] = (HW.mfail[manualUid] or 0) + 1
                            if HW.mfail[manualUid] >= 3 then HW.manual[manualUid] = nil; print("[KakaxiHW] giving up on manual egg " .. tostring(manualUid)) end
                        end
                    end
                end)
                if not ok then HW.stats.fails += 1; HW.lastErr = tostring(err); warn("[KakaxiHW] error: " .. tostring(err)); task.wait(0.5) end
                task.wait(0.05)
            end
            HW.running = false
            if genvH.__KakaxiHWRun == H then genvH.__KakaxiHWRun = nil end
            setStatus("Idle")
            if gui.Parent and wanted() then start() return end
            if gui.Parent and not wanted() then print("[KakaxiHW] nothing left to do - leaving Halloween") pcall(exitDimension) end
        end)
    end

    local function refresh()
        if wanted() then start() end
    end

    function HW.options()
        local names, rars, seenN, seenR = {}, {}, {}, {}
        local hp = okReq(RS:FindFirstChild("Data") and RS.Data:FindFirstChild("HalloweenPets"))
        local specs = hp and hp.Specs
        if type(specs) == "table" then
            for id, sp in pairs(specs) do
                if type(sp) == "table" then
                    local nm = sp.Source or sp.EggSource or sp.EggModel or sp.DisplayName or id
                    if type(nm) == "string" and not seenN[nm] then seenN[nm] = true; names[#names + 1] = nm end
                    local r = sp.Rarity
                    if r ~= nil then r = tostring(r); if not seenR[r] then seenR[r] = true; rars[#rars + 1] = r end end
                end
            end
        end
        table.sort(names)
        local order = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Cosmic", "Secret", "Eternal", "Divine"}
        local rank = {}
        for i, v in ipairs(order) do rank[v:lower()] = i end
        table.sort(rars, function(a, b) return (rank[a:lower()] or 99) < (rank[b:lower()] or 99) end)
        return names, rars
    end
    function HW.setAuto(v) HW.auto = v == true; refresh() end
    function HW.queue(uid)
        if not uid then return end
        HW.manual[uid] = true
        if HW.mfail then HW.mfail[uid] = nil end
        print("[KakaxiHW] manual queued uid=" .. tostring(uid))
        refresh()
    end
    function HW.unqueue(uid) HW.manual[uid] = nil end
    function HW.isQueued(uid) return HW.manual[uid] == true end
    function HW.stop() HW.auto = false; HW.manual = {}; local H = genvH.__KakaxiHWRun; if H then H.running = false end end

    task.spawn(function()
        while gui.Parent do task.wait(1) end
        pcall(HW.stop)
    end)
end)()
-- ========= КНОПКА KAKAXI В ЛЕВОМ СТОЛБЦЕ (над «Магазин») =========
do
    local NAME = "KakaxiLeftButton"
    local CS = game:GetService("CollectionService")

    local function make(left)
        if left:FindFirstChild(NAME) then return end
        local shop = left:FindFirstChild("ShopBTN")
        if not shop then return end

        -- шаг между кнопками считаем по соседней кнопке под «Магазином»
        local gap = 0.332
        for _, n in ipairs({"IndexBTN", "SpeedMulti"}) do
            local o = left:FindFirstChild(n)
            if o and o:IsA("GuiObject") then
                gap = o.Position.Y.Scale - shop.Position.Y.Scale
                break
            end
        end

        local b = shop:Clone()
        b.Name = NAME
        for _, d in ipairs(b:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then
                d:Destroy()
            elseif d:IsA("TextLabel") or d:IsA("TextButton") then
                d.Text = "Kakaxi"
            elseif d:IsA("ImageLabel") and d.AbsoluteSize.X < shop.AbsoluteSize.X * 0.5 then
                d.Visible = false -- иконка тележки
            end
        end
        -- убираем теги, чтобы игра не повесила на копию открытие магазина
        pcall(function()
            for _, t in ipairs(CS:GetTags(b)) do CS:RemoveTag(b, t) end
            for _, d in ipairs(b:GetDescendants()) do
                for _, t in ipairs(CS:GetTags(d)) do CS:RemoveTag(d, t) end
            end
        end)
        -- розовая окраска
        local PINK_A, PINK_B = Color3.fromRGB(255, 105, 180), Color3.fromRGB(255, 160, 215)
        local PINK_DARK = Color3.fromRGB(120, 20, 70)
        local hasGrad = false
        for _, d in ipairs(b:GetDescendants()) do
            if d:IsA("UIGradient") then
                hasGrad = true
                d.Color = ColorSequence.new(PINK_A, PINK_B)
            elseif d:IsA("UIStroke") then
                d.Color = PINK_DARK
            end
        end
        b.BackgroundColor3 = PINK_A
        if not hasGrad then
            -- у копии нет градиента: убираем зелёную картинку и рисуем кнопку сами
            if b:IsA("ImageButton") then b.Image = "" end
            b.BackgroundTransparency = 0
            if not b:FindFirstChildOfClass("UICorner") then
                Instance.new("UICorner", b).CornerRadius = UDim.new(0.22, 0)
            end
            Instance.new("UIGradient", b).Color = ColorSequence.new(PINK_A, PINK_B)
            local st = Instance.new("UIStroke", b)
            st.Color = PINK_DARK
            st.Thickness = 2
        end
        b.Position = UDim2.new(shop.Position.X.Scale, shop.Position.X.Offset,
            shop.Position.Y.Scale - gap, shop.Position.Y.Offset)
        b.Visible = true
        left.ClipsDescendants = false

        b.Activated:Connect(function()
            win.Visible = not win.Visible
            floatBtn.Visible = not win.Visible
        end)
        b.Parent = left
    end

    task.spawn(function()
        while gui.Parent do
            pcall(function()
                local pg = LP:FindFirstChildOfClass("PlayerGui")
                local hud = pg and pg:FindFirstChild("HUD")
                if not hud then return end
                for _, h in ipairs(hud:GetChildren()) do
                    local left = h:FindFirstChild("LeftControls")
                    if left then pcall(make, left) end
                end
            end)
            task.wait(2)
        end
        pcall(function()
            local hud = LP.PlayerGui:FindFirstChild("HUD")
            if hud then
                for _, o in ipairs(hud:GetDescendants()) do
                    if o.Name == NAME then o:Destroy() end
                end
            end
        end)
    end)
end
