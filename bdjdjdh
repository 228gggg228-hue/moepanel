        local plus = button(f, cx + 126, cy, 44, 38, Color3.fromRGB(55, 55, 62), 10)
        label(plus, "+", 0, 0, 44, 38, 24, C.text, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
