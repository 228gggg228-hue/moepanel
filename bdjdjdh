    local function buildPanel()
        if pgui and pgui.Parent then return true end
        local pg = LP:FindFirstChildOfClass("PlayerGui")
        local src = pg and pg:FindFirstChild("GrowingEggs")
        if not src then return false end
        local srcFrame = src:FindFirstChild("Frame")
        local refStroke = srcFrame and srcFrame:FindFirstChildOfClass("UIStroke")
        local ref = (refStroke and refStroke.Thickness > 0) and refStroke.Thickness or STROKE_BASE_T
        local clone
        pcall(function() clone = src:Clone() end)
        if not clone then return false end
        clone.Name = "KakaxiHudPanel"
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("LuaSourceContainer") then
                d:Destroy()
            else
                pcall(function() for _, t in ipairs(CS:GetTags(d)) do CS:RemoveTag(d, t) end end)
            end
        end
        clone.Enabled = false; clone.ResetOnSpawn = false
        clone.DisplayOrder = src.DisplayOrder + 1
        clone.IgnoreGuiInset = src.IgnoreGuiInset
        local frame = clone:FindFirstChild("Frame")
        local header = frame and frame:FindFirstChild("Header")
        local sf = frame and frame:FindFirstChild("ScrollingFrame")
        local template = sf and sf:FindFirstChild("Template")
        if not (frame and header and sf and template) then clone:Destroy(); return false end

        -- обводки игрового окна запоминаем в относительных единицах (потом масштабируются с панелью)
        for _, d in ipairs(clone:GetDescendants()) do
            if d:IsA("UIStroke") then
                local okm, mode = pcall(function() return d.StrokeSizingMode end)
                if (not okm) or mode ~= Enum.StrokeSizingMode.ScaledSize then
                    d:SetAttribute("KDesign", d.Thickness / ref * STROKE_BASE_T)
                end
            end
        end

        for _, c in ipairs(sf:GetChildren()) do
            if c:IsA("GuiObject") and c ~= template and c.Name ~= "EmptyLast" then c:Destroy() end
        end
