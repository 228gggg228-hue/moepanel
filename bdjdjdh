        s:SetAttribute("KDesign", th)
        return s
    end
    local function corner(o, r) return inst("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
    local function seq(t)
        local k = {}
        for i, v in ipairs(t) do k[i] = ColorSequenceKeypoint.new(v[1], v[2]) end
        return ColorSequence.new(k)
    end
    local function gradOf(o)
        local g = o:FindFirstChildOfClass("UIGradient")
        if not g then g = Instance.new("UIGradient"); g.Parent = o end
        return g
    end

    local CS = game:GetService("CollectionService")
    local TweenService = game:GetService("TweenService")

    -- ================= РАЗМЕРЫ (как у Steal Panel) =================
    local PANEL_W, PANEL_H, PANEL_ASPECT = 0.3, 0.62, 0.86 -- 30% x 62% экрана, пропорции 0.86
    local ROW_RATIO = 4.426229508196721                     -- высота строки = ширина списка / 4.426
    local STROKE_BASE_W, STROKE_BASE_T = 556, 2.3120369911193848
    local PANEL_SHOWN = UDim2.new(1, -12, 0.5, 0)
