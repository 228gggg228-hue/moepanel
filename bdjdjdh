    local nameIdx
    local function petRarityByName(nm)
        if type(nm) ~= "string" or nm == "" then return nil end
        local res
        pcall(function()
            if not nameIdx then
                nameIdx = {}
                local assets = require(game:GetService("ReplicatedStorage").Data.Assets)
                for _, cfg in pairs(assets.Directory or {}) do
                    if type(cfg) == "table" and type(cfg.DisplayName) == "string" then nameIdx[cfg.DisplayName:lower()] = cfg end
                end
            end
            local low = nm:lower()
            local cfg = nameIdx[low]
            if not cfg then
                local bestLen = 0
                for k, c in pairs(nameIdx) do -- название с приставкой-мутацией: ищем самое длинное совпадение с конца
                    if #k > bestLen and #low > #k and low:sub(-#k) == k then cfg, bestLen = c, #k end
                end
            end
            local rar = cfg and cfg.Rarity
            if rar then
                local rname = type(rar) == "table" and (rar.DisplayName or rar.Name or rar._id) or tostring(rar)
                local color = type(rar) == "table" and typeof(rar.Color) == "Color3" and rar.Color or nil
                if not color then local r = rarityByName(rname); color = r and r.color end
                if rname then res = {name = tostring(rname), color = color or C.sub} end
            end
        end)
        return res
    end

    local function fmtWeight(w)
        if w < 1000 then return string.format("%.1f kg", w) end
        return formatMoney(w) .. " kg"
    end

    local function scaled(lbl, maxSize, minSize)
        lbl.TextScaled = true
        new("UITextSizeConstraint", {MaxTextSize = maxSize, MinTextSize = minSize}, lbl)
    end

    -- иконка: ImageLabel из игры, ViewportFrame или деталь (Handle яйца) в ViewportFrame
    -- яркий вариант цвета редкости для оформления (тёмные/серые цвета, например у Secret, делаем заметными)
    local function vivid(c)
        local h, sat, val = Color3.toHSV(c)
        if val < 0.35 or sat < 0.15 then return Color3.fromRGB(95, 95, 125) end
        return Color3.fromHSV(h, math.max(sat, 0.6), math.max(val, 0.85))
    end

    local function makeIcon(src, parent, x, y, size, glow, deco)
        local holder = frame(parent, x, y, size, size, Color3.fromRGB(26, 26, 32), 14)
        holder.ClipsDescendants = true
        if deco then
            -- вместо тёмной плитки: прозрачный фон и светлые круги за питомцем
            holder.BackgroundTransparency = 1
            for _, d in ipairs({{0.96, 0.82}, {0.66, 0.74}}) do
                local ring = new("Frame", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                    Size = UDim2.fromScale(d[1], d[1]), BackgroundColor3 = deco:Lerp(Color3.new(1, 1, 1), 0.35),
                    BackgroundTransparency = d[2], BorderSizePixel = 0}, holder)
                new("UICorner", {CornerRadius = UDim.new(1, 0)}, ring)
            end
            glow = nil
        end
        if glow then
            new("ImageLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                Image = glow.Image, ImageColor3 = glow.ImageColor3, ImageTransparency = 0.35,
                ScaleType = Enum.ScaleType.Fit}, holder)
        end
        if not src then return end
        if type(src) == "string" then
            new("ImageLabel", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromScale(0.86, 0.86), BackgroundTransparency = 1, Image = src,
                ScaleType = Enum.ScaleType.Fit}, holder)
            return
        end
        if src:IsA("ImageLabel") then
            new("ImageLabel", {AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5),
                Size = UDim2.fromScale(0.86, 0.86), BackgroundTransparency = 1,
                Image = src.Image, ImageRectOffset = src.ImageRectOffset,
                ImageRectSize = src.ImageRectSize, ScaleType = Enum.ScaleType.Fit}, holder)
        elseif src:IsA("ViewportFrame") then
            pcall(function()
                local c = src:Clone()
                c.Position = UDim2.fromScale(0, 0)
                c.Size = UDim2.fromScale(1, 1)
                c.AnchorPoint = Vector2.new(0, 0)
                c.BackgroundTransparency = 1
                c.Parent = holder
            end)
        elseif src:IsA("Model") then
            pcall(function()
                local vp = new("ViewportFrame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                    Ambient = Color3.fromRGB(190, 190, 190), LightColor = Color3.new(1, 1, 1)}, holder)
                local clone = src:Clone()
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("LuaSourceContainer") then
                        d:Destroy()
                    elseif d:IsA("BasePart") then
                        d.Anchored = true
                    end
                end
                clone:PivotTo(CFrame.new(0, 0, 0))
                clone.Parent = vp
                local cf, size = clone:GetBoundingBox()
                local cam = Instance.new("Camera")
                cam.FieldOfView = 40
                local dist = math.max(size.Magnitude, 1) * 0.85
                cam.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0.5, 0.3, 1).Unit * dist, cf.Position)
                cam.Parent = vp
                vp.CurrentCamera = cam
            end)
        elseif src:IsA("BasePart") then
            pcall(function()
                local vp = new("ViewportFrame", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1,
                    Ambient = Color3.fromRGB(190, 190, 190), LightColor = Color3.new(1, 1, 1)}, holder)
                local clone = src:Clone()
                for _, d in ipairs(clone:GetDescendants()) do
                    if d:IsA("LuaSourceContainer") or d:IsA("JointInstance") or d:IsA("TouchTransmitter") then d:Destroy() end
                end
                clone.Anchored = true
                clone.CFrame = CFrame.new(0, 0, 0)
                clone.Parent = vp
                local cam = Instance.new("Camera")
                cam.FieldOfView = 40
                local dist = math.max(clone.Size.Magnitude, 0.5) * 1.35
                cam.CFrame = CFrame.lookAt(Vector3.new(0.35, 0.25, 1).Unit * dist, Vector3.zero)
                cam.Parent = vp
                vp.CurrentCamera = cam
            end)
        end
    end

    -- ---------- сбор данных: активные питомцы (список из игры) ----------
    local function findActiveList(pg)
        local counter, counterTxt
        for _, o in ipairs(pg:GetDescendants()) do
            if o:IsA("TextLabel") and not o:IsDescendantOf(gui) then
                local t = cleanText(o.Text)
                if t:find("Актив", 1, true) or t:lower():find("active", 1, true) then
                    local a, b = t:match("(%d+)%s*/%s*(%d+)")
                    if a then
                        counter, counterTxt = o, a .. " / " .. b .. " активно"
                        break
                    end
                end
            end
        end
        if not counter then return nil, nil end
        local p = counter.Parent
        for _ = 1, 8 do
            if not p or p == pg then break end
            for _, d in ipairs(p:GetDescendants()) do
                if d:IsA("ScrollingFrame") and not d:IsDescendantOf(gui) then return d, counterTxt end
            end
            p = p.Parent
        end
        return nil, counterTxt
    end

    local function visibleKids(o)
        local r = {}
        for _, c in ipairs(o:GetChildren()) do
            if c:IsA("GuiObject") and c.Visible then table.insert(r, c) end
        end
        return r
    end

    local function rowsOf(sf)
        local k = visibleKids(sf)
        while #k == 1 do
            local inner = visibleKids(k[1])
            if #inner > 1 then k = inner else break end
        end
        return k
    end

    local function parseRow(row)
        local icon, glow
        local texts, cands = {}, {}
        for _, d in ipairs(row:GetDescendants()) do
            if d:IsA("ImageLabel") then
                if d.Name == "Icon" and d.Image ~= "" then
                    icon = d
                elseif d.Name == "Glow" and d.Image ~= "" then
                    glow = d
                    table.insert(cands, hexOf(d.ImageColor3))
                end
            elseif d:IsA("ViewportFrame") then
                if not icon then icon = d end
            elseif d:IsA("TextLabel") or d:IsA("TextButton") then
                local t = cleanText(d.Text)
                if t ~= "" and not isAction(t) then
                    table.insert(texts, {t = t, y = d.AbsolutePosition.Y, x = d.AbsolutePosition.X})
                    local raw = d.Text:match('color="(#%x+)"')
                    if raw then table.insert(cands, raw:lower()) end
                    table.insert(cands, hexOf(d.TextColor3))
                end
            elseif d:IsA("Frame") and d.Parent and d.Parent.Name == "Decor" then
                table.insert(cands, hexOf(d.BackgroundColor3))
            end
        end
        if not icon then
            local best = 0
            for _, d in ipairs(row:GetDescendants()) do
                if d:IsA("ImageLabel") and d.Image ~= "" and d.Name ~= "Glow" and d.Name ~= "Pattern" and d.Name ~= "Spacer" then
                    local ar = d.AbsoluteSize.X * d.AbsoluteSize.Y
                    if ar > best then icon, best = d, ar end
                end
            end
        end
        if #texts == 0 then return nil end
        table.sort(texts, function(a, b)
            if math.abs(a.y - b.y) > 2 then return a.y < b.y end
            return a.x < b.x
        end)
        local main = texts[1].t
        local name, extra = main:match("^(.-)%s*(%(.*%))%s*$")
        if not name or name == "" then name, extra = main, "" end
        for i = 2, #texts do extra = (extra ~= "" and extra .. " " or "") .. texts[i].t end
        extra = extra:gsub("^%(", ""):gsub("%)$", "")
        local rarity
        for _, h in ipairs(cands) do
            local info = rarityMap[h]
            if info then
                local ok, c3 = pcall(Color3.fromHex, h)
                rarity = {name = info.name, color = ok and c3 or C.sub, rank = info.rank}
                break
            end
        end
        if not rarity then rarity = petRarityByName(name) end
        return {name = name, extra = extra, icon = icon, glow = glow, rarity = rarity,
            uid = row.Name:match("^Pet_(%x+)$"),
            y = row.AbsolutePosition.Y, x = row.AbsolutePosition.X}
    end

    local function toolsByUid()
        local m = {}
        for _, container in ipairs({LP:FindFirstChild("Backpack"), LP.Character}) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") then
                        local u = t:GetAttribute("UID")
                        if u then m[tostring(u)] = t end
                    end
                end
            end
        end
        return m
    end

    local function collectPets()
        local pg = LP:FindFirstChildOfClass("PlayerGui")
        if not pg then return {}, nil end
        local rows = {}
        local sf, counterTxt = findActiveList(pg)
        if sf then
            local tm = toolsByUid()
            for _, r in ipairs(rowsOf(sf)) do
                local item = parseRow(r)
                if item then
                    local tool = item.uid and tm[item.uid]
                    if tool then
                        item.weight = tonumber(tool:GetAttribute("Weight"))
                        item.scale = tonumber(tool:GetAttribute("Scale"))
                        local mu = tool:GetAttribute("Mutations")
                        if mu and tostring(mu) ~= "" then item.mutations = tostring(mu) end
                    end
                    item.key = item.icon and (item.icon:IsA("ImageLabel") and item.icon.Image or item.icon.ClassName) or ""
                    table.insert(rows, item)
                end
            end
            table.sort(rows, function(a, b)
                if math.abs(a.y - b.y) > 2 then return a.y < b.y end
                return a.x < b.x
            end)
        end
        return rows, counterTxt
    end

    -- ---------- ТОЧНЫЙ ДОХОД: читаем из окна «Продать яйца» ----------
    -- Структура окна: SellPrompt.Frame.ScrollingFrame.VisibleCards.<UID>.Template с полями
    --   Icon (иконка яйца), Amount ("$15.7B/s" - доход, уже с учётом мутаций), Weight ("(1,973Kg)"), ValueHolder.Value (цена).
    -- Яйца в рюкзаке опознаём по иконке и весу. Окно держит в списке только показанные карточки, поэтому
    -- всё прочитанное запоминаем: откройте «Продать яйца» и пролистайте список, чтобы набрать данные по всем яйцам.
    local sellIncomeByWeight = {}     -- "иконка|вес" -> {income, price}
    local sellIncomeWeightOnly = {}   -- запасной ключ: только вес
    local function digitsOf(s) return (tostring(s):gsub("%D", "")) end
    local function plain(s)
        s = s:gsub("<[^>]+>", "")
        s = s:gsub("%s+", " ")
        return (s:match("^%s*(.-)%s*$"))
    end
    local function isIncomeText(t) return t:match("^%$[%d%.,]+%a*%s*/") ~= nil end
    local function weightOf(t) return t:match("^%(([%d,%.]+)[^%)]*%)$") end

    local function scanSellWindow()
        local pg = LP:FindFirstChildOfClass("PlayerGui")
        local cards = dig(pg, "SellPrompt", "Frame", "ScrollingFrame", "VisibleCards")
        if not cards then return end
        for _, card in ipairs(cards:GetChildren()) do
            local tpl = card:FindFirstChild("Template")
            local am = tpl and tpl:FindFirstChild("Amount")
            local wt = tpl and tpl:FindFirstChild("Weight")
            if am and wt and am:IsA("TextLabel") and wt:IsA("TextLabel") then
                local income = plain(am.Text)
                local w = weightOf(plain(wt.Text))
                if isIncomeText(income) and w then
                    local digits = digitsOf(w)
                    local ic = tpl:FindFirstChild("Icon")
                    local icon = (ic and ic:IsA("ImageLabel")) and ic.Image or ""
                    local vl = dig(tpl, "ValueHolder", "Value")
                    local price = (vl and vl:IsA("TextLabel")) and plain(vl.Text) or nil
                    if digits ~= "" then
                        local rec = {income = income, price = price, uid = card.Name}
                        sellIncomeByWeight[icon .. "|" .. digits] = rec
                        sellIncomeWeightOnly[digits] = rec
                    end
                end
            end
        end
    end

    -- ---------- ТОЧНЫЙ ДОХОД БЕЗ ОКНА ПРОДАЖИ: данные твоих яиц из самой игры ----------
    -- EggState.ReadOwnerEggs(UserId) отдаёт все твои яйца: AssetCategory, AssetScale, Mutations.
    -- Доход считаем игровой функцией AssetItems.SalePrice (цена = доход * 100), а вес яйца берём из
    -- AssetItems.WeightKg, чтобы сопоставить запись с яйцом в списке рюкзака (по названию и весу).
    local EggStateMod, EggRecordsMod
    pcall(function() EggStateMod = require(game:GetService("ReplicatedStorage").Client.EggState) end)
    pcall(function() EggRecordsMod = require(game:GetService("ReplicatedStorage").Shared.Util.EggRecords) end)
    local ownedByKey, ownedByDigits, ownedAt = {}, {}, -100
    local ownedList = {}

    local function refreshOwned()
        if os.clock() - ownedAt < 2 then return end
        ownedAt = os.clock()
        if not (EggStateMod and AssetItemsMod and type(EggStateMod.ReadOwnerEggs) == "function") then return end
        local okc, recs = pcall(EggStateMod.ReadOwnerEggs, LP.UserId)
        if not okc or type(recs) ~= "table" then return end
        local byKey, byDigits, list = {}, {}, {}
        for uid, rec in pairs(recs) do
            if type(rec) == "table" and type(rec.AssetCategory) == "string" and type(rec.AssetScale) == "number" then
                local item = {Category = rec.AssetCategory, Scale = rec.AssetScale,
                    Mutations = type(rec.Mutations) == "table" and rec.Mutations or {}}
                local okp, price = pcall(AssetItemsMod.SalePrice, item)
                local okw, kg = pcall(AssetItemsMod.WeightKg, item)
                if okp and type(price) == "number" and okw and type(kg) == "number" then
                    local digits = tostring(math.floor(kg + 0.5))
                    local entry = {income = fmtIncome(price / 100), uid = uid}
                    -- цена продажи самого яйца (если игра даст посчитать)
                    if EggRecordsMod and type(EggRecordsMod.SellPrice) == "function" then
                        local oks, sp = pcall(EggRecordsMod.SellPrice, rec)
                        if oks and type(sp) == "number" then entry.price = "$" .. formatMoney(sp) end
                    end
                    entry.cat, entry.digits, entry.kg, entry.rec = rec.AssetCategory, digits, kg, rec
                    table.insert(list, entry)
                    byKey[rec.AssetCategory .. "|" .. digits] = byKey[rec.AssetCategory .. "|" .. digits] or entry
                    if byDigits[digits] == nil then byDigits[digits] = entry else byDigits[digits] = false end
                end
            end
        end
        ownedByKey, ownedByDigits, ownedList = byKey, byDigits, list
    end

    local function ownedLookup(eggName, weightDigits)
        pcall(refreshOwned)
        local cat = tostring(eggName):gsub("%s+Egg$", "")
        return ownedByKey[cat .. "|" .. weightDigits] or ownedByDigits[weightDigits] or nil
    end

    -- ---------- сбор данных: яйца из инвентаря (окно рюкзака в игре) ----------
    -- Яйца в игре лежат не как Tool, а как кнопки в списке BackpackGui.Backpack.Main.Inventory.ScrollingFrame.
    -- Этот список показывает ту вкладку, которая открыта (Eggs / Pets), поэтому читаем его только на вкладке яиц
    -- и запоминаем последний результат.
    local function rarityFromCands(cands)
        for _, h in ipairs(cands) do
            local info = rarityMap[h]
            if info then
                local ok, c3 = pcall(Color3.fromHex, h)
                return {name = info.name, color = ok and c3 or C.sub, rank = info.rank}
            end
        end
    end

    local function collectEggs()
        local pg = LP:FindFirstChildOfClass("PlayerGui")
        local bpg = pg and pg:FindFirstChild("BackpackGui")
        if not bpg then return nil end
        local cap = dig(bpg, "Backpack", "Main", "Inventory", "Capacity")
        local catLbl = dig(bpg, "Backpack", "Main", "Inventory", "CategoryLabel")
        local word = (cap and (cap:IsA("TextLabel") or cap:IsA("TextButton"))) and parseBag(cap.Text) or nil
        local isEggs = (word == "eggs")
            or (word == nil and catLbl ~= nil and catLbl:IsA("TextLabel") and catLbl.Text:lower():find("egg", 1, true) ~= nil)
        if not isEggs then return nil end
        local sf = dig(bpg, "Backpack", "Main", "Inventory", "ScrollingFrame")
        if not sf then return nil end

        local rows = {}
        local tm = toolsByUid()
        for _, b in ipairs(sf:GetChildren()) do
            if b:IsA("GuiButton") and b.Visible then
                local icon = b:FindFirstChild("Icon")
                local tn = b:FindFirstChild("ToolName")
                if icon and icon:IsA("ImageLabel") and icon.Image ~= "" and tn and tn:IsA("TextLabel") then
                    local text = cleanText(tn.Text)
                    if text ~= "" then
                        -- "Volcano Egg (3,307Kg)" -> имя и вес
                        local name, wt = text:match("^(.-)%s*%((.-)%)%s*$")
                        if not name or name == "" then name, wt = text, "" end
                        local am = dig(b, "BaseTemplate", "Amount")
                        local note = (am and am:IsA("TextLabel") and cleanText(am.Text) ~= "") and cleanText(am.Text) or nil
                        local cands = {hexOf(tn.TextColor3), hexOf(b.BackgroundColor3)}
                        for _, d in ipairs(b:GetChildren()) do
                            if d:IsA("ImageLabel") and d.Name ~= "Icon" and d.Name ~= "FavIcon" then
                                table.insert(cands, hexOf(d.ImageColor3))
                            end
                        end
                        local wd = digitsOf(wt)
                        local sc = sellIncomeByWeight[icon.Image .. "|" .. wd] or sellIncomeWeightOnly[wd]
                            or ownedLookup(name, wd) or {}
                        local tool = sc.uid and tm[sc.uid]
                        local toolCat, mutText
                        if tool then
                            toolCat = tool:GetAttribute("AssetCategory")
                            local mu = tool:GetAttribute("Mutations")
                            if mu and tostring(mu) ~= "" then mutText = tostring(mu) end
                        end
                        -- мутации яйца (иконки в карточке рюкзака)
                        local muts = {}
                        local mf = dig(b, "BaseTemplate", "Mutations")
                        if mf then
                            for _, d in ipairs(mf:GetDescendants()) do
                                if d:IsA("ImageLabel") and d.Name ~= "Template" and d.Image ~= "" then
                                    table.insert(muts, d.Image)
                                end
                            end
                        end
                        table.insert(rows, {name = name, extra = wt, icon = icon, key = icon.Image, iconId = icon.Image,
                            weightDigits = digitsOf(wt), sellIncome = sc.income, sellPrice = sc.price, mutIcons = muts,
                            rarity = rarityFromCands(cands), note = note,
                            category = toolCat or b:GetAttribute("AssetCategory") or icon:GetAttribute("AssetCategory"), mutText = mutText,
                            y = b.AbsolutePosition.Y, x = b.AbsolutePosition.X})
                    end
                end
            end
        end
        table.sort(rows, function(a, b)
            if math.abs(a.y - b.y) > 2 then return a.y < b.y end
            return a.x < b.x
        end)
        return rows
    end

    -- ---------- ПРЕДИКТ: кто вылупится из яйца ----------
    -- У яиц в руках (в том числе у других игроков) есть атрибут AssetCategory: это питомец внутри яйца
    -- (например "Orca" для "Orca Egg"). Запоминаем соответствие "название яйца -> питомец".
    -- Для яиц из окна рюкзака: сначала эта память, потом база игры (Data.Assets.Directory: у каждого питомца есть
    -- Egg = {DisplayName, Icon}, сверяем по названию и по иконке яйца), и только потом приблизительная догадка по названию.
    local RSS = game:GetService("ReplicatedStorage")
    local eggCategoryCache = {}
    local assetsData

    local function getAssets()
        if assetsData == nil then
            local ok, d = pcall(function() return require(RSS.Data.Assets) end)
            assetsData = (ok and type(d) == "table") and d or false
        end
        return assetsData or nil
    end

    local function learnEggs()
        local function scan(container)
            if not container then return end
            for _, t in ipairs(container:GetChildren()) do
                if t:IsA("Tool") and t:GetAttribute("ItemType") == "AssetEgg" then
                    local dn, cat = t:GetAttribute("DisplayName"), t:GetAttribute("AssetCategory")
                    if dn and cat then eggCategoryCache[tostring(dn)] = tostring(cat) end
                end
            end
        end
        scan(LP:FindFirstChild("Backpack"))
        for _, plr in ipairs(Players:GetPlayers()) do scan(plr.Character) end
    end

    -- индекс яиц из базы игры: у каждого питомца в Data.Assets.Directory есть Egg = {DisplayName, Icon}
    local eggIndex
    local function getEggIndex()
        if eggIndex then return eggIndex end
        eggIndex = {byName = {}, byIcon = {}}
        local assets = getAssets()
        local dir = assets and assets.Directory
        if type(dir) == "table" then
            for cat, cfg in pairs(dir) do
                if type(cfg) == "table" and type(cfg.Egg) == "table" then
                    local nm, ic = cfg.Egg.DisplayName, cfg.Egg.Icon
                    if type(nm) == "string" then
                        local k = nm:lower()
                        eggIndex.byName[k] = eggIndex.byName[k] or {}
                        table.insert(eggIndex.byName[k], cat)
                    end
                    if type(ic) == "string" and ic ~= "" then
                        eggIndex.byIcon[ic] = eggIndex.byIcon[ic] or {}
                        table.insert(eggIndex.byIcon[ic], cat)
                    end
                end
            end
        end
        return eggIndex
    end

    -- возвращает: категория, источник ("tool" / "dir" / "name") либо nil, nil, список вариантов
    local function resolveCategory(item)
        local assets = getAssets()
        local dir = assets and assets.Directory
        local models = RSS:FindFirstChild("AssetModels")
        local function known(c)
            return type(c) == "string" and ((dir and dir[c] ~= nil) or (models and models:FindFirstChild(c) ~= nil))
        end
        if known(item.category) then return item.category, "tool" end
        local c = eggCategoryCache[item.name]
        if known(c) then return c, "tool" end

        local idx = getEggIndex()
        local cands = idx.byName[item.name:lower()] or {}
        if #cands > 1 and item.iconId then
            local f = {}
            for _, k in ipairs(cands) do
                local e = type(dir[k]) == "table" and dir[k].Egg
                if type(e) == "table" and e.Icon == item.iconId then table.insert(f, k) end
            end
            if #f > 0 then cands = f end
        end
        if #cands == 0 and item.iconId then cands = idx.byIcon[item.iconId] or {} end
        if #cands == 1 then return cands[1], "dir" end
        if #cands > 1 then return nil, nil, cands end

        -- запасной вариант: по названию яйца
        local base = (item.name:gsub("%s*[Ee]gg%s*$", ""))
        if known(base) then return base, "name" end
        if dir then
            local match, n = nil, 0
            local lb = base:lower()
            for key in pairs(dir) do
                if type(key) == "string" and key:lower():find(lb, 1, true) then match, n = key, n + 1 end
            end
            if n == 1 then return match, "name" end
        end
        return nil
    end

    local function rarityOfCategory(assets, cat, cfg)
        local rar = type(cfg) == "table" and cfg.Rarity or nil
        local name, color
        if type(rar) == "table" then
            name = rar.DisplayName or rar.Name or rar._id
            if typeof(rar.Color) == "Color3" then color = rar.Color end
        elseif type(rar) == "string" then
            name = rar
        end
        if not name and assets and type(assets.ByRarity) == "table" then
            for rn, list in pairs(assets.ByRarity) do
                if type(list) == "table" then
                    for k, v in pairs(list) do
                        if k == cat or v == cat
                            or (type(v) == "table" and (v.Name == cat or v.Category == cat or v.DisplayName == cat)) then
                            name = rn
                        end
                    end
                end
                if name then break end
            end
        end
        if name and not color then
            local r = rarityByName(name)
            color = r and r.color
        end
        if name then return {name = tostring(name), color = color or C.sub} end
        return nil
    end

    -- Доход яйца без окна продажи: игровая функция AssetItems.SalePrice (цена = доход * 100).
    -- Размер яйца берём из веса в рюкзаке: подбираем Scale так, чтобы AssetItems.WeightKg совпал с весом.
    -- Вес в рюкзаке округлён, поэтому такой доход приблизительный (≈); точный - из окна «Продать яйца».
    local scaleCache = {}
    local function scaleFromWeight(cat, kg)
        local key = cat .. "|" .. kg
        if scaleCache[key] ~= nil then return scaleCache[key] or nil end
        local function w(scale)
            local ok, v = pcall(AssetItemsMod.WeightKg, {Category = cat, Scale = scale, Mutations = {}})
            return ok and type(v) == "number" and v or nil
        end
        local lo, hi = 0.001, 1000
        local wl, wh = w(lo), w(hi)
        if not (wl and wh and wl < wh and kg >= wl and kg <= wh) then scaleCache[key] = false; return nil end
        for _ = 1, 60 do
            local mid = math.sqrt(lo * hi)
            local wm = w(mid)
            if not wm then scaleCache[key] = false; return nil end
            if wm < kg then lo = mid else hi = mid end
        end
        local res = math.sqrt(lo * hi)
        scaleCache[key] = res
        return res
    end

    local function approxEggIncome(cat, item)
        if not (AssetItemsMod and type(AssetItemsMod.SalePrice) == "function" and type(AssetItemsMod.WeightKg) == "function") then return nil end
        -- мутации известны только по тексту (если яйцо было в руках); по одним иконкам названия не узнать
        if item.mutIcons and #item.mutIcons > 0 and not item.mutText then return nil end
        local kg = tonumber(tostring(item.extra or ""):gsub(",", ""):match("[%d%.]+") or "")
        if not kg or kg <= 0 then return nil end
        local scale = scaleFromWeight(cat, kg)
        if not scale then return nil end
        return calcIncome({AssetCategory = cat, Scale = scale, Mutations = item.mutText or ""})
    end

    local function predictEgg(item)
        local cat, src, cands = resolveCategory(item)
        local assets = getAssets()
        local dir = assets and assets.Directory
        if not cat then
            if cands and #cands > 1 and type(dir) == "table" then
                local names = {}
                for _, k in ipairs(cands) do
                    local c = dir[k]
                    table.insert(names, (type(c) == "table" and type(c.DisplayName) == "string" and c.DisplayName) or tostring(k))
                end
                table.sort(names)
                return {ambiguous = names}
            end
            return nil
        end
        local cfg = type(dir) == "table" and dir[cat] or nil
        local models = RSS:FindFirstChild("AssetModels")
        local dn = cat
        if type(cfg) == "table" and type(cfg.DisplayName) == "string" and cfg.DisplayName ~= "Assets" then dn = cfg.DisplayName end
        local icon
        if type(cfg) == "table" and type(cfg.Icon) == "string" and cfg.Icon ~= "" then
            icon = cfg.Icon -- иконка питомца из базы игры
        else
            icon = models and models:FindFirstChild(cat) or nil -- запасной вариант: 3D-модель
        end
        local extra, hint = "", nil
        if item.sellIncome then
            extra = item.sellIncome -- точный доход из окна «Продать яйца»
            hint = "с текущими мутациями; при росте добавятся новые"
        else
            local approx = approxEggIncome(cat, item)
            if approx then
                extra = "≈ " .. approx
                hint = "расчёт по весу яйца (приблизительно); точный доход: открой «Продать яйца»"
            elseif type(cfg) == "table" and type(cfg.EarningRate) == "number" then
                extra = "база $" .. formatMoney(cfg.EarningRate) .. "/s"
                hint = "точный доход: открой «Продать яйца»"
            end
        end
        local notes = {tool = "по данным яйца", dir = "по базе игры", name = "по названию (приблизительно)"}
        return {name = dn, extra = extra, icon = icon,
            rarity = rarityOfCategory(assets, cat, cfg), note = notes[src], hint = hint}
    end

