-- Питомцы: лежат в Backpack как Tool с ItemType = "Asset", считаем их напрямую (всегда актуально).
-- Яйца: в Backpack их нет, игра показывает их число только в подписи окна рюкзака
--   PlayerGui.BackpackGui.Backpack.Main.Inventory.Capacity  (например "Eggs: 41/115").
-- Эта подпись показывает ту вкладку, которая открыта ("Eggs" или "Pets"), поэтому запоминаем
-- последние значения для каждой вкладки. Чтобы число яиц обновилось, открой в рюкзаке вкладку "Яйца".
local bagInfo = {} -- bagInfo["eggs"] = {количество, вместимость}

local function parseBag(text)
    text = text:gsub("<[^>]+>", "") -- убираем RichText-теги вида <font ...>
    local word, n, cap = text:match("^%s*(%a+)%s*:?%s*(%d+)%s*/%s*(%d+)")
    if word and tonumber(cap) ~= 4500 then return word:lower(), tonumber(n), tonumber(cap) end
end

local function pollBagLabel()
    local pg2 = LP:FindFirstChildOfClass("PlayerGui")
    local bpg = pg2 and pg2:FindFirstChild("BackpackGui")
    if not bpg then return end
    -- сначала известная подпись, потом запасной поиск по всему окну рюкзака
    local lbl = dig(bpg, "Backpack", "Main", "Inventory", "Capacity")
    if lbl and (lbl:IsA("TextLabel") or lbl:IsA("TextButton")) then
        local w, n, cap = parseBag(lbl.Text)
        if w then bagInfo[w] = {n, cap}; return end
    end
    for _, o in ipairs(bpg:GetDescendants()) do
        if (o:IsA("TextLabel") or o:IsA("TextButton")) and o.Text:find("/") then
            local w, n, cap = parseBag(o.Text)
            if w then bagInfo[w] = {n, cap} end
        end
    end
end

local function countPets()
    local pets = 0
    local function scan(container)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and t:GetAttribute("ItemType") == "Asset" then pets += 1 end
        end
    end
    scan(LP:FindFirstChild("Backpack"))
    scan(LP.Character)
    return pets
end

local function bagText(n, cap)
    if n == nil then return "—" end
    return cap and (n .. " / " .. cap) or tostring(n)
end

