-- превращает "in 11s", "in 3m 20s", "in 1:05" в секунды
local function parseDuration(txt)
    if not txt then return nil end
    local mm, ss = txt:match("(%d+):(%d+)")
    if mm then return tonumber(mm) * 60 + tonumber(ss) end
    local h = txt:match("(%d+)%s*h")
    local m = txt:match("(%d+)%s*m")
    local s2 = txt:match("(%d+)%s*s")
    if h or m or s2 then
        return (tonumber(h) or 0) * 3600 + (tonumber(m) or 0) * 60 + (tonumber(s2) or 0)
    end
    return nil
end

local function fmtTime(sec)
    sec = math.max(0, math.floor(sec + 0.5))
    if sec >= 60 then return string.format("%dm %02ds", sec // 60, sec % 60) end
    return sec .. "s"
end

