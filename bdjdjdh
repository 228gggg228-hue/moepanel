-- Кнопка копирует вид кнопок игры и встаёт в их столбец над кнопкой с яйцом.
-- Нажатие открывает панель справа (копия окна «Растущие яйца»). Свои строки: KakaxiPanel.add("Название", функция)
do
    local Players = game:GetService("Players")
    local UIS = game:GetService("UserInputService")
    local LP = Players.LocalPlayer
    local BTN_NAME = "KakaxiHudButton"
    local BLUE = Color3.fromRGB(46, 96, 235)
    local BLUE_DARK = Color3.fromRGB(20, 40, 120)
    -- циклы панели живут, пока жив ScreenGui хаба (gui); при закрытии хаба всё убирается
    local host = gui.Parent
    for _, n in ipairs({"KakaxiHudPanel", "KakaxiHudBtnGui"}) do
        pcall(function() local o = host:FindFirstChild(n); if o then o:Destroy() end end)
    end

    local function fmtIncome(n)
        if n < 100000 then
            local str = tostring(math.floor(n + 0.5))
            str = str:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
            return "$" .. str .. "/s"
        end
        local suffixes = {"K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No"}
        local idx = 0
        while n >= 1000 and idx < #suffixes do n = n / 1000; idx = idx + 1 end
        local txt = string.format("%.1f", n):gsub("%.0$", "")
        return "$" .. txt .. suffixes[idx] .. "/s"
    end

    local P = Color3.fromRGB
    local function inst(class, props, parent)
        local o = Instance.new(class)
        for k, v in pairs(props or {}) do o[k] = v end
        o.Parent = parent
        return o
    end
    -- толщина обводки хранится в атрибуте KDesign (для ширины панели 556 px) и масштабируется вместе с панелью
    local function stroke(o, th, col)
