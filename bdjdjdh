local SUFFIXES = {"K","M","B","T","Qa","Qi","Sx","Sp","Oc","No","Dc","Ud","Dd","Td","Qad","Qid","Sxd","Spd","Ocd","Nod","Vg"}
local MULT = {}
for i, sfx in ipairs(SUFFIXES) do MULT[sfx:lower()] = 10 ^ (3 * i) end

local function parseMoney(v)
    if type(v) == "number" then return v end
    local txt = (tostring(v):gsub("[%$,%s]", ""))
    local num, sfx = txt:match("^([%d%.]+)(%a*)$")
    local n = tonumber(num)
    if not n then return nil end
    if sfx ~= "" then
        local m = MULT[sfx:lower()]
        if not m then return nil end
        n = n * m
    end
    return n
end

local function formatMoney(n)
    if n < 1000 then
        return string.format("%d", math.floor(n + 0.5))
    end
    local idx = math.min(math.floor(math.log10(n) / 3), #SUFFIXES)
    local str = string.format("%.2f", n / 10 ^ (3 * idx))
    if str:find("%.") then
        str = str:gsub("0+$", "")
        str = str:gsub("%.$", "")
    end
    return str .. SUFFIXES[idx]
end

-- автопоиск: leaderstats -> атрибут -> текст на HUD вида "$48.3Qa"
