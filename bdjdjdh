    local function dropdown(f, options, multi, defaultSel, emptyText, cb)
        local sel = {}
        for _, v in ipairs(defaultSel or {}) do sel[v] = true end
        local btn = button(f, ROW_W - 16 - 300, (f.Size.Y.Offset - 38) / 2, 300, 38, Color3.fromRGB(24, 24, 27), 10)
        stroke(btn, C.stroke, 1)
        local txt = label(btn, "", 12, 0, 250, 38, 15, C.text, Enum.Font.GothamMedium)
        txt.TextTruncate = Enum.TextTruncate.AtEnd
        label(btn, "▾", 266, 0, 28, 38, 16, C.sub, Enum.Font.GothamBold, Enum.TextXAlignment.Center)
        local function chosen()
            local out = {}
            for _, o in ipairs(options) do if sel[o] then table.insert(out, o) end end
            return out
        end
        local function refreshText()
            local c = chosen()
            if #c == 0 then txt.Text = emptyText
            elseif #c <= 2 then txt.Text = table.concat(c, ", ")
            else txt.Text = #c .. " выбрано" end
        end
        refreshText()

        local popup = new("Frame", {Size = UDim2.fromOffset(300, 320), BackgroundColor3 = Color3.fromRGB(32, 32, 36), BorderSizePixel = 0,
            Visible = false, ZIndex = 2}, popupLayer)
        corner(popup, 12); stroke(popup, Color3.fromRGB(80, 80, 90), 1)
        local sbox
        if #options > 12 then
            sbox = new("TextBox", {Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(284, 30), BackgroundColor3 = Color3.fromRGB(22, 22, 25),
                BorderSizePixel = 0, Text = "", PlaceholderText = "Поиск...", PlaceholderColor3 = C.sub, TextColor3 = C.text,
                Font = Enum.Font.GothamMedium, TextSize = 15, ClearTextOnFocus = false}, popup)
            corner(sbox, 8)
        end
        local top0 = sbox and 44 or 8
        local list = new("ScrollingFrame", {Position = UDim2.fromOffset(6, top0), Size = UDim2.fromOffset(288, 320 - top0 - 6), BackgroundTransparency = 1,
            BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y}, popup)
        new("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder}, list)
        local rows = {}
        for i, o in ipairs(options) do
            local rb = new("TextButton", {Size = UDim2.new(1, -6, 0, 32), BackgroundColor3 = Color3.fromRGB(40, 40, 46), BackgroundTransparency = 1,
                Text = "", AutoButtonColor = false, LayoutOrder = i}, list)
            corner(rb, 8)
            local box = frame(rb, 8, 6, 20, 20, Color3.fromRGB(22, 22, 25), 5)
            stroke(box, Color3.fromRGB(110, 110, 125), 1)
            local ck = label(box, "✓", 0, 0, 20, 20, 15, Color3.fromRGB(70, 240, 90), Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
            ck.Visible = sel[o] == true
            label(rb, tostring(o), 38, 0, 240, 32, 15, C.text, Enum.Font.GothamMedium)
            rows[i] = {btn = rb, name = tostring(o):lower(), ck = ck}
            rb.MouseEnter:Connect(function() rb.BackgroundTransparency = 0.4 end)
            rb.MouseLeave:Connect(function() rb.BackgroundTransparency = 1 end)
            rb.MouseButton1Click:Connect(function()
                if multi then
                    sel[o] = (not sel[o]) or nil
                    ck.Visible = sel[o] == true
                else
                    sel = {[o] = true}
                    for _, r2 in ipairs(rows) do r2.ck.Visible = false end
                    ck.Visible = true
                    closePopup()
                end
                refreshText()
                pcall(cb, multi and chosen() or o)
            end)
        end
        if sbox then
            sbox:GetPropertyChangedSignal("Text"):Connect(function()
                local q = sbox.Text:lower()
                for _, r in ipairs(rows) do r.btn.Visible = (q == "") or (r.name:find(q, 1, true) ~= nil) end
            end)
        end
        btn.MouseButton1Click:Connect(function()
            if currentPopup == popup then closePopup(); return end
            closePopup()
            local s = uiScale and uiScale.Scale or 1
            local ax = (btn.AbsolutePosition.X - page.AbsolutePosition.X) / s
            local ay = (btn.AbsolutePosition.Y - page.AbsolutePosition.Y) / s
            local pageH = page.AbsoluteSize.Y / s
            local py = ay + 42
            if py + 320 > pageH then py = math.max(4, ay - 324) end
            popup.Position = UDim2.fromOffset(math.max(4, ax + 300 - 300), py)
            popup.Visible = true; popupLayer.Visible = true; currentPopup = popup
        end)
        return {chosen = chosen, getSingle = function() for _, o in ipairs(options) do if sel[o] then return o end end end}
    end

    -- ===== списки вариантов (как в Sena) =====
    local function listOf(t)
        local out = {}
        for _, v in ipairs(type(t) == "table" and t or {}) do
            if v ~= "None" and v ~= "" then out[#out + 1] = v end
        end
        return out
    end
    local rarities = {}
    pcall(function() for _, v in ipairs(cat.getRarities()) do rarities[#rarities + 1] = v end end)
    if #rarities == 0 then rarities = {"Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic", "Cosmic", "Secret", "Eternal", "Divine"} end
    local mutations = {}
    pcall(function() for _, v in ipairs(cat.getMutations()) do mutations[#mutations + 1] = v end end)
    if #mutations == 0 then mutations = {"Golden", "Rainbow", "Shocked", "Frozen", "Burnt", "Boss"} end
    local eggNames, areaNames = {}, {}
    pcall(function()
        local RS = game:GetService("ReplicatedStorage")
        local areasDir = require(RS.Data.Areas).Directory
        local assets = require(RS.Data.Assets)
        local seen = {}
        for _, a in pairs(areasDir) do
            if type(a) == "table" and type(a.DropTable) == "table" then
                for _, d in ipairs(a.DropTable) do
                    local id = d[1]
                    if type(id) == "string" and not seen[id] then
                        seen[id] = true
                        local cfgA = assets.Directory and assets.Directory[id]
                        eggNames[#eggNames + 1] = cfgA and cfgA.DisplayName or id
                    end
                end
            end
        end
        table.sort(eggNames)
        local pref = {"Lake", "Jungle", "Desert", "Snow", "Volcano", "Abyss Ocean", "Prehistoric", "Cosmic", "Cherry Blossom", "Titan Temple"}
        local have, used = {}, {}
        for k, a in pairs(areasDir) do if type(a) == "table" and type(a.DropTable) == "table" then have[k] = true end end
        for _, k in ipairs(pref) do if have[k] and k ~= "Titan Temple" then areaNames[#areaNames + 1] = k; used[k] = true end end
        local rest = {}
        for k in pairs(have) do if not used[k] and k ~= "Forest" and k ~= "Titan Temple" then rest[#rest + 1] = k end end
        table.sort(rest)
        for _, k in ipairs(rest) do areaNames[#areaNames + 1] = k end
        if have["Titan Temple"] then areaNames[#areaNames + 1] = "Titan Temple" end
    end)
    if #areaNames == 0 then areaNames = {"Lake", "Jungle", "Desert", "Snow", "Volcano", "Abyss Ocean", "Prehistoric", "Cosmic", "Cherry Blossom", "Titan Temple"} end

    -- ===== применение настроек к движку (логика из Sena) =====
    local function applyAutoSteal(v)
        if v == true then
            local hwm = genv2.__KakaxiHW
            if hwm and hwm.auto then pcall(hwm.setAuto, false) end
        end
        cfg.AutoSteal = v == true
        rt:setEnabled(cfg.AutoSteal)
        if type(genv2.__SenaV4SetStealDeclutter) == "function" then pcall(genv2.__SenaV4SetStealDeclutter, cfg.AutoSteal) end
    end
    local function applyMode(arg)
        local s = type(arg) == "string" and arg or ""
        local low = s:lower()
        local zig = low:find("zig") ~= nil
        local mode = (s:find("Fly") or s:find("High") or zig) and "Fly" or "Instant"
        local aerial = mode == "Fly" and not zig and (s:find("%(Fly%)") ~= nil or low:find("aerial") ~= nil)
        local zigzag = zig and mode == "Fly"
        cfg.StealMode, cfg.FlyAerial, cfg.FlyZigzag = mode, aerial, zigzag
        if rt.captureObjectiveEnabled then rt._modeBeforeCapture = {mode, aerial, zigzag}
        else rt:setStealMode(mode, aerial, zigzag) end
    end
    local function applyFilter(kind, key, cfgKey, list)
        list = listOf(list)
        cfg[cfgKey] = list
        rt:setFilter(kind, list)
        rt:setFilterEnabled(key, #list > 0)
    end
    local function parseValue(text)
        local tmp = {}
        cfg.applyStealValueInput(tmp, text)
        return tmp.StealMinValue or 0
    end

