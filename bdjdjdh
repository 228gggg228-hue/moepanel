    -- ===== яйца на карте под охраной стражников: питомец внутри, редкость, доход в секунду =====
    local RSS2 = game:GetService("ReplicatedStorage")
    local assetsMod, rarityMod, itemsMod, eggStateMod2, viewportMod
    local function lazyRequire(path)
        local o = RSS2
        for part in path:gmatch("[^%.]+") do o = o and o:FindFirstChild(part) end
        if not o then return nil end
        local ok, m = pcall(require, o)
        return ok and m or nil
    end
    local rarityCache = {}
    local function rarityByName(name)
        rarityMod = rarityMod or lazyRequire("Data.Rarity")
        local key = tostring(name):lower():gsub("%s+", "")
        for k, r in pairs((rarityMod and rarityMod.Rarities) or {}) do
            local k1 = tostring(k):lower():gsub("%s+", "")
            local k2 = tostring(type(r) == "table" and r.DisplayName or ""):lower():gsub("%s+", "")
            if k1 == key or k2 == key then
                local c = type(r) == "table" and r.Color
                if typeof(c) == "ColorSequence" then c = c.Keypoints[1].Value end
                return typeof(c) == "Color3" and c or nil
            end
        end
        return nil
    end
    local function petRarity(cat, cfg)
        if rarityCache[cat] ~= nil then return rarityCache[cat] or nil end
        local out = false
        pcall(function()
            local rid = type(cfg) == "table" and cfg.Rarity or nil
            if rid == nil then return end
            local name = type(rid) == "table" and tostring(rid.DisplayName or rid.Name or rid._id or "") or tostring(rid)
            if name == "" then return end
            local color = rarityByName(name)
            if not color and type(rid) == "table" and typeof(rid.Color) == "Color3" then color = rid.Color end
            out = {name = name, color = color}
        end)
        rarityCache[cat] = out
        return out or nil
    end

    local function fmtKg(kg)
        return (tostring(math.floor(kg + 0.5)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", ""))
    end

    local guardAreasCache, warnedNoCat, fieldRF, fetching, hallowIndex, hallowPets
    local function guardAreas()
        if guardAreasCache then return guardAreasCache end
        local out = {}
        pcall(function()
            local ga = workspace:FindFirstChild("World") and workspace.World:FindFirstChild("Areas")
            ga = ga and ga:FindFirstChild("GuardAreas")
            for _, area in ipairs(ga and ga:GetChildren() or {}) do
                for _, m in ipairs(area:GetDescendants()) do
                    if m:IsA("Model") and m.Name:find("Guard") then
                        table.insert(out, {name = area.Name, pos = m:GetPivot().Position})
                        break
                    end
                end
            end
        end)
        if #out > 0 then guardAreasCache = out end
        return out
    end
    local function areaOfEgg(rec)
        if type(rec.AreaId) == "string" then return rec.AreaId end
        if type(rec.Uid) == "string" then
            local a = rec.Uid:match("_(%a+):Slot")
            if a then return a end
        end
        local pos
        pcall(function() pos = rec.BoundsCFrame and rec.BoundsCFrame.Position or rec.BottomCFrame.Position end)
        if pos then
            local best, bd
            for _, g in ipairs(guardAreas()) do
                local dist = (Vector3.new(g.pos.X, 0, g.pos.Z) - Vector3.new(pos.X, 0, pos.Z)).Magnitude
                if not bd or dist < bd then best, bd = g.name, dist end
            end
            if best then return best end
        end
        return "?"
    end

    local function collectMapPets()
        eggStateMod2 = eggStateMod2 or lazyRequire("Client.EggState")
        assetsMod = assetsMod or lazyRequire("Data.Assets")
        itemsMod = itemsMod or lazyRequire("Shared.Util.AssetItems")
        if not itemsMod then return nil end
        local data
        local rf = fieldRF
        if not rf then
            local net = RSS2:FindFirstChild("Packages") and RSS2.Packages:FindFirstChild("Networking")
            rf = net and net:FindFirstChild("RF/EggWorld/AskFieldEggSnapshot")
            fieldRF = rf
        end
        if rf then
            local ok, res = pcall(function() return rf:InvokeServer() end)
            if ok and type(res) == "table" then data = res end
        end
        if not data and eggStateMod2 and type(eggStateMod2.ReadFieldEggs) == "function" then
            local ok, res = pcall(eggStateMod2.ReadFieldEggs)
            if ok then data = res end
        end
        local recs = type(data) == "table" and data.Records
        if type(recs) ~= "table" then recs = {} end
        local dir = assetsMod and assetsMod.Directory
        local want, anyWant = {}, false
        for name in pairs(sortSelected) do want[name:lower()] = true; anyWant = true end
        local list = {}
        local total, withCat, sampleKeys = 0, 0, nil
        for _, rec in pairs(recs) do
            total += 1
            if type(rec) == "table" and (rec.AssetCategory or rec.Category) then withCat += 1
            elseif type(rec) == "table" and not sampleKeys then
                local ks = {}
                for k in pairs(rec) do table.insert(ks, tostring(k)) end
                table.sort(ks); sampleKeys = table.concat(ks, ",")
            end
            local cat = type(rec) == "table" and (rec.AssetCategory or rec.Category)
            local scale = type(rec) == "table" and tonumber(rec.AssetScale or rec.Scale)
            if type(cat) == "string" and scale and (rec.State == nil or rec.State == "Slot" or rec.State == "Dropped") then
                local muts = {}
                if type(rec.Mutations) == "table" then for _, m in pairs(rec.Mutations) do table.insert(muts, tostring(m)) end end
                table.sort(muts)
                local okp, price = pcall(itemsMod.SalePrice, {Category = cat, Scale = scale, Mutations = muts})
                if okp and type(price) == "number" then
                    local cfg = type(dir) == "table" and dir[cat] or nil
                    local rar = petRarity(cat, cfg)
                    if not anyWant or (rar and want[rar.name:lower()]) then
                        table.insert(list, {uid = tostring(rec.Uid or rec.UID or (cat .. scale)), mps = price / 100,
                            d = {Category = cat, Scale = scale, Mutations = muts}, cfg = cfg, rar = rar, area = areaOfEgg(rec)})
                    end
                end
            end
        end
        pcall(function()
            local hd = workspace:FindFirstChild("HalloweenDimension")
            local we = hd and hd:FindFirstChild("WorldEggs")
            if not we then return end
            if not hallowIndex then
                hallowPets = lazyRequire("Data.HalloweenPets")
                local specs = hallowPets and hallowPets.Specs
                if type(specs) ~= "table" then return end
                hallowIndex = {}
                for _, field in ipairs({"Source", "EggSource", "EggModel", "DisplayName", "Id"}) do
                    for id, sp in pairs(specs) do
                        if type(sp) == "table" and type(sp[field]) == "string" then
                            local k = sp[field]:lower()
                            if not hallowIndex[k] then hallowIndex[k] = id end
                        end
                    end
                end
            end
            local specs = hallowPets and hallowPets.Specs
            if not (specs and hallowIndex) then return end
            for _, m in ipairs(we:GetChildren()) do
                local nm = m:GetAttribute("PreparedSourceName")
                local uid = m:GetAttribute("HalloweenEggUid") or tostring(m)
                local id = type(nm) == "string" and hallowIndex[nm:lower()]
                local sp = id and specs[id]
                if sp then
                    local scale = tonumber(m:GetAttribute("AssetScale")) or 1
                    pcall(function() scale = m:GetScale() end)
                    local rate = tonumber(sp.EarningRate) or 0
                    local mult = scale <= 5 and scale ^ 1.85 or (scale / 5) ^ 1.2 * 19.637875755794113
                    local rname = tostring(sp.Rarity or "")
                    local rar = rname ~= "" and {name = rname, color = rarityByName(rname)} or nil
                    if not anyWant or (rar and want[rname:lower()]) then
                        table.insert(list, {uid = "H" .. tostring(uid), mps = rate * mult, tag = "Halloween",
                            d = {Category = id, Scale = scale, Mutations = {}}, cfg = sp, rar = rar,
                            area = "Halloween Z" .. tostring(m:GetAttribute("Zone") or "?")})
                    end
                end
            end
        end)
        if total > 0 and withCat == 0 and not warnedNoCat then
            warnedNoCat = true
            pcall(function() if setclipboard then setclipboard("Поля яйца на карте: " .. tostring(sampleKeys)) end end)
            toast("В данных яиц нет категории. Поля скопированы в буфер - пришли их мне")
        end
        if eggMode ~= "All" then
            for i = #list, 1, -1 do
                local isHal = list[i].tag ~= nil
                if (eggMode == "1" and isHal) or (eggMode == "2" and not isHal) then table.remove(list, i) end
            end
        end
        table.sort(list, function(a, b) return a.mps > b.mps end)
        while #list > 60 do table.remove(list) end
        return list
    end

    -- строки питомцев в раскладке Steal Panel:
    -- иконка слева (0.2 x 1.3), справа название (градиент редкости), доход (зелёный градиент),
    -- вес/размер (синий градиент), значок ранга #N (жёлто-оранжевый), мутации справа вверху
    local function renderPets(list)
        if not panelParts then return end
        local sig = {}
        for _, e in ipairs(list) do table.insert(sig, e.uid .. ":" .. e.mps) end
        local sg = #list .. "|" .. table.concat(sig, ",")
        if sg == petsSig then return end
        petsSig = sg
        for _, r in ipairs(madePets) do pcall(function() r:Destroy() end) end
        madePets = {}
        if #list == 0 then return end
        local rh = rowHeight()
        for i, e in ipairs(list) do
            local d, cfg, rar = e.d, e.cfg, e.rar
            local muts = {}
            if type(d.Mutations) == "table" then for _, m in pairs(d.Mutations) do table.insert(muts, tostring(m)) end end
            table.sort(muts)
            local base = (type(cfg) == "table" and type(cfg.DisplayName) == "string" and cfg.DisplayName ~= "Assets") and cfg.DisplayName or d.Category
            local kg
            if itemsMod and not e.tag then
                local ok, w = pcall(itemsMod.WeightKg, {Category = d.Category, Scale = d.Scale, Mutations = muts})
                if ok and type(w) == "number" then kg = w end
            end
            local color = (rar and readable(rar.color)) or Color3.fromRGB(235, 235, 245)

            local row = panelParts.template:Clone()
            row.Name = "Pet" .. i; row.Visible = true; row.LayoutOrder = 1000 + i
            row.Size = UDim2.new(1, 0, 0, rh)
            row.Parent = panelParts.list
            table.insert(madePets, row)
            local sp = row:FindFirstChild("Spacer")
            if sp then
                -- цветная подложка строки по редкости (градиент + рамка) и белое свечение за иконкой
                local tint = inst("Frame", {Name = "KTint", Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BackgroundTransparency = 0.55,
                    BorderSizePixel = 0, ZIndex = 0}, sp)
                corner(tint, 6)
                inst("UIGradient", {Rotation = 0, Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.35),
                    NumberSequenceKeypoint.new(1, 0.85)})}, tint)
                local ts = stroke(tint, 1.6, color)
                ts.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                local glow = sp:FindFirstChild("Glow")
                if glow then glow.Visible = true; glow.ImageColor3 = Color3.new(1, 1, 1); glow.ImageTransparency = 0 end
                local icon = sp:FindFirstChild("Icon")
                if icon then
                    if type(cfg) == "table" and type(cfg.Icon) == "string" and cfg.Icon ~= "" then
                        icon.Image = cfg.Icon
                    else
                        icon.Image = ""
                        viewportMod = viewportMod or lazyRequire("Client.AssetViewport")
                        local okv = false
                        if viewportMod then
                            okv = pcall(function()
                                local vp = viewportMod.Mount(icon)
                                vp.Size = UDim2.fromScale(1, 1); vp.Position = UDim2.fromScale(0.5, 0.5)
                                vp.AnchorPoint = Vector2.new(0.5, 0.5); vp.BackgroundTransparency = 1; vp.ZIndex = 6
                                viewportMod.ShowAsset(d.Category, vp, true)
                            end)
                        end
                        if not okv then addLabel(icon, "🐾", nil, 5) end
                    end
                end
                local prog = sp:FindFirstChild("Progress"); if prog then prog.Visible = false end
                local skip = sp:FindFirstChild("Skip"); if skip then skip.Visible = false end
                local op = sp:FindFirstChild("Open"); if op then op.Visible = false end

                local nl = sp:FindFirstChild("TextLabel")
                local vl, dl = sp:FindFirstChild("Value"), sp:FindFirstChild("Detail")
                local rk, mt = sp:FindFirstChild("Rank"), sp:FindFirstChild("Mut")
                if nl then
                    nl.Text = base
                    local g = gradOf(nl)
                    if rar and tostring(rar.name):upper() == "SECRET" then
                        g.Color = SECRET_SEQ
                    else
                        g.Color = seq({{0, color}, {1, color}})
                    end
                    g.Rotation = 90
                end
                if vl then vl.Text = fmtIncome(e.mps) end
                if dl then
                    -- вместо размера «x…» в строке стоят мутации (Silver, Golden, Halloween…) оранжевым, затем вес синим
                    local gl = dl:FindFirstChildOfClass("UIGradient"); if gl then gl:Destroy() end
                    dl.RichText = true
                    local parts = {}
                    local all = {}
                    for _, m in ipairs(muts) do table.insert(all, m) end
                    if e.tag then table.insert(all, e.tag) end
                    if #all > 0 then
                        table.insert(parts, '<font color="rgb(255,150,60)">' .. table.concat(all, " ") .. '</font>')
                    end
                    if kg then
                        table.insert(parts, '<font color="rgb(70,160,255)">' .. fmtKg(kg) .. ' Kg</font>')
                    end
                    dl.Text = table.concat(parts, '<font color="rgb(255,255,255)">  ·  </font>')
                end
                if rk then rk.Text = "#" .. i; rk.Visible = true end
                if mt then mt.Visible = false end
                -- кнопка Steal: поставить именно это яйцо в очередь движка Auto Steal
                do
                    local isHw = e.tag ~= nil
                    local hwUid = isHw and tostring(e.uid):sub(2) or nil
                    local sb = mkStyleBtn(sp, "Steal", STY.Steal, 1)
                    sb.Button.AnchorPoint = Vector2.new(1, 0.5)
                    sb.Button.Position = UDim2.fromScale(0.985, 0.5)
                    sb.Button.Size = UDim2.fromScale(0.2, 0.42)
                    sb.Button.ZIndex = 8
                    for _, dsc in ipairs(sb.Button:GetDescendants()) do
                        if dsc:IsA("GuiObject") then dsc.ZIndex = dsc.ZIndex + 5 end
                    end
                    hoverScale(sb)
                    local function paintQ(q)
                        sb.Label.Text = q and "Cancel" or "Steal"
                        applyStyle(sb, q and STY.Cancel or STY.Steal)
                    end
                    local S0 = getgenv().__KakaxiSena
                    local qd = false
                    if isHw then
                        local HW0 = getgenv().__KakaxiHW
                        qd = HW0 ~= nil and HW0.isQueued(hwUid) == true
                    else
                        pcall(function() qd = S0 and S0.runtime.manualQueue[e.uid] == true end)
                    end
                    paintQ(qd)
                    sb.Button.Activated:Connect(function()
                        if isHw then
                            local HW1 = getgenv().__KakaxiHW
                            if not HW1 then
                                sb.Label.Text = "No engine"
                                task.delay(1.5, function() paintQ(false) end)
                                return
                            end
                            if qd then
                                HW1.unqueue(hwUid); qd = false; paintQ(false)
                            else
                                -- обычный Auto Steal на время Хэллоуин-кражи выключаем, чтобы не мешал
                                local S2 = getgenv().__KakaxiSena
                                if S2 and S2.setAuto and S2.cfg.AutoSteal == true then pcall(S2.setAuto, false) end
                                HW1.queue(hwUid); qd = true; paintQ(true)
                            end
                            return
                        end
                        local S1 = getgenv().__KakaxiSena
                        if not (S1 and S1.runtime and S1.runtime.queueManual) then
                            sb.Label.Text = "No engine"
                            task.delay(1.5, function() paintQ(false) end)
                            return
                        end
                        if qd then
                            -- отмена: убрать это яйцо из ручной очереди движка
                            local okc = pcall(function()
                                local rt1 = S1.runtime
                                rt1.manualQueue[e.uid] = nil
                                for i = #rt1.manualOrder, 1, -1 do
                                    if rt1.manualOrder[i] == e.uid then table.remove(rt1.manualOrder, i) end
                                end
                                if #rt1.manualOrder == 0 then rt1:clearManual() else rt1:_reconcileRunningState() end
                            end)
                            if okc then qd = false; paintQ(false) end
                            return
                        end
                        local ok = pcall(function() S1.runtime:queueManual({e.uid}) end)
                        if ok then qd = true; paintQ(true) else sb.Label.Text = "Error"; task.delay(1.5, function() paintQ(false) end) end
                    end)
                end
            end
        end
        applyStrokes()
    end

