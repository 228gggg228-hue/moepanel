    -- переключает рюкзак на «Яйца» (пока рюкзак закрыт), читает список и возвращает вкладку обратно.
    local lastHiddenLoad = -100
    local function collectEggsHidden()
        if openingBag then return nil end
        local inv = bagInventory()
        if not inv or inv.Visible then return nil end -- рюкзак открыт: ты смотришь его сам, не мешаем
        if os.clock() - lastHiddenLoad < 20 and #eggView.rows > 0 then return nil end
        lastHiddenLoad = os.clock()
        openingBag = true
        local rows
        pcall(function()
            local prev = currentBagTab(inv) or "Pets"
            if selectBagTab(inv, "Eggs") then
                task.wait(0.5) -- дать списку обновиться
                rows = collectEggs()
                selectBagTab(inv, prev)
            end
        end)
        openingBag = false
        return rows
    end

    -- Яйца в руках / в хотбаре (только что украденные) в списке рюкзака не показываются: игра держит их
    -- как Tool. Добавляем их в список сами: название, вес, доход и предикт считаем по данным яйца.
    local function rarityOfCategory(cat)
        local out
        pcall(function()
            local assets = getAssets()
            local cfg = assets and assets.Directory and assets.Directory[cat]
            local rid = cfg and cfg.Rarity
            if rid == nil then return end
            local rdata = require(RSS.Data.Rarity)
            for k, r in pairs(rdata.Rarities or {}) do
                if k == rid or r._id == rid or r.DisplayName == rid then
                    out = {name = r.DisplayName or tostring(rid), color = typeof(r.Color) == "Color3" and r.Color or C.sub,
                        rank = r.Rank or 0}
                    return
                end
            end
        end)
        return out
    end

    -- Имя и иконку яйца запоминаем из списка рюкзака (там они всегда верные): категория = питомец внутри,
    -- а название яйца у разных биомов своё. Так яйцо в руках / в хотбаре сразу показывается с верным названием.
    local eggInfoCache = {}
    local function learnEggInfo(uiRows)
        for _, r in ipairs(uiRows or {}) do
            if r.weightDigits and r.weightDigits ~= "" then
                local e = ownedByDigits[r.weightDigits]
                if e and e.cat and r.name and r.name ~= "" then
                    eggInfoCache[e.cat] = {name = r.name, icon = r.iconId}
                end
            end
        end
    end

    -- яйцо в хотбаре: ItemType может быть другим, поэтому смотрим ещё на категорию и на название
    local function isEggTool(t)
        local it = tostring(t:GetAttribute("ItemType") or "")
        if it == "AssetEgg" then return true end
        if it == "Asset" then return false end
        local cat = t:GetAttribute("AssetCategory")
        if cat ~= nil then
            local idx = getEggIndex()
            for _, list in pairs(idx.byIcon) do
                for _, c in ipairs(list) do if c == cat then return true end end
            end
        end
        local nm = tostring(t:GetAttribute("DisplayName") or t.Name):lower()
        return it:lower():find("egg", 1, true) ~= nil or nm:find("egg", 1, true) ~= nil or nm:find("яйц", 1, true) ~= nil
    end

    local function heldEggRows(uiRows)
        local rows = {}
        local used = {}
        for _, container in ipairs({LP:FindFirstChild("Backpack"), LP.Character}) do
            if container then
                for _, t in ipairs(container:GetChildren()) do
                    if t:IsA("Tool") and isEggTool(t) then
                        local cat = t:GetAttribute("AssetCategory")
                        local scale = tonumber(t:GetAttribute("Scale") or t:GetAttribute("AssetScale"))
                        local name = tostring(t:GetAttribute("DisplayName") or t.Name)
                        if cat and eggInfoCache[cat] then name = eggInfoCache[cat].name end
                        local kg
                        if AssetItemsMod and cat and scale then
                            local muts = {}
                            local raw = t:GetAttribute("Mutations")
                            if type(raw) == "string" then
                                for m in raw:gmatch("[^,]+") do
                                    m = m:gsub("^%s+", ""):gsub("%s+$", "")
                                    if m ~= "" then table.insert(muts, m) end
                                end
                            end
                            local okw, w = pcall(AssetItemsMod.WeightKg, {Category = cat, Scale = scale, Mutations = muts})
                            if okw and type(w) == "number" then kg = w end
                        end
                        local digits = kg and tostring(math.floor(kg + 0.5)) or ""
                        -- уже есть в списке рюкзака (после переноса) - второй раз не добавляем
                        local dup = false
                        for i, r in ipairs(uiRows or {}) do
                            if not used[i] and ((digits ~= "" and r.weightDigits == digits) or (digits == "" and r.name == name)) then
                                used[i] = true; dup = true; break
                            end
                        end
                        if not dup then
                            local iconId
                            local idx = getEggIndex()
                            for ic, list in pairs(idx.byIcon) do
                                for _, c in ipairs(list) do
                                    if c == cat then iconId = ic; break end
                                end
                                if iconId then break end
                            end
                            if cat and eggInfoCache[cat] and eggInfoCache[cat].icon then iconId = eggInfoCache[cat].icon end
                            if not iconId and t.TextureId ~= "" then iconId = t.TextureId end
                            local mu = t:GetAttribute("Mutations")
                            table.insert(rows, {name = name,
                                extra = kg and ((tostring(math.floor(kg + 0.5)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")) .. "Kg") or "",
                                icon = iconId, key = iconId or name, iconId = iconId, weightDigits = digits,
                                sellIncome = calcIncome(t:GetAttributes()), mutIcons = {},
                                rarity = cat and rarityOfCategory(cat) or nil, note = "в руках",
                                category = cat, mutText = (mu and tostring(mu) ~= "") and tostring(mu) or nil,
                                y = 1e9, x = #rows})
                        end
                    end
                end
            end
        end
        return rows
    end

    -- Яйцо, которое лежит в хотбаре (не в руках), в списке рюкзака не видно, а как Tool его нет.
    -- Но игра знает все твои яйца (ReadOwnerEggs): добавляем те, которых нет в списке.
    local function extraOwnedRows(shownRows)
        pcall(refreshOwned)
        local total = #ownedList
        if total == 0 or #shownRows >= total then return {} end
        local used, missing = {}, {}
        local function fmtKg(k)
            return (tostring(math.floor(k + 0.5)):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")) .. "Kg"
        end
        for _, e in ipairs(ownedList) do
            local assets = getAssets()
            local cfg = assets and assets.Directory and assets.Directory[e.cat]
            local egg = type(cfg) == "table" and type(cfg.Egg) == "table" and cfg.Egg or {}
            local ci = eggInfoCache[e.cat]
            local nm = tostring((ci and ci.name) or egg.DisplayName or (e.cat .. " Egg"))
            local found = false
            -- вес в списке почти уникален, а название яйца не равно категории питомца: сопоставляем по весу
            for i, r in ipairs(shownRows) do
                if not used[i] and r.weightDigits == e.digits then
                    used[i] = true; found = true; break
                end
            end
            if not found then
                local mu = type(e.rec.Mutations) == "table" and table.concat(e.rec.Mutations, ", ") or nil
                local icon = (ci and ci.icon) or (type(egg.Icon) == "string" and egg.Icon ~= "" and egg.Icon) or nil
                table.insert(missing, {name = nm, extra = fmtKg(e.kg), icon = icon, key = icon or nm, iconId = icon,
                    weightDigits = e.digits, sellIncome = e.income, sellPrice = e.price, mutIcons = {},
                    rarity = rarityOfCategory(e.cat), note = "в хотбаре", category = e.cat,
                    mutText = (mu and mu ~= "") and mu or nil, y = 1e9, x = #missing})
            end
        end
        -- не больше, чем не хватает до общего числа яиц (защита от ложных дублей из-за округления веса)
        local need = total - #shownRows
        while #missing > need do table.remove(missing) end
        return missing
    end

    local lastUiRows = {}
    task.spawn(function()
        task.wait(3)
        while gui.Parent do
            pcall(learnEggs)
            pcall(scanSellWindow)
            local ok, rows = pcall(collectEggs)
            if not (ok and rows) then
                local ok2, rows2 = pcall(collectEggsHidden)
                if ok2 and rows2 then ok, rows = true, rows2 end
            end
            if ok and rows then lastUiRows = rows end
            pcall(refreshOwned)
            pcall(learnEggInfo, lastUiRows)
            -- список рюкзака + яйца в руках
            local merged = {}
            for _, r in ipairs(lastUiRows) do table.insert(merged, r) end
            local okh, held = pcall(heldEggRows, lastUiRows)
            if okh and held then for _, r in ipairs(held) do table.insert(merged, r) end end
            local oke, extra = pcall(extraOwnedRows, merged)
            if oke and extra then for _, r in ipairs(extra) do table.insert(merged, r) end end
            if #merged > 0 or (ok and rows) then eggView.render(merged) end
            local eb = bagInfo["eggs"]
            local exact = 0
            for _, r in ipairs(eggView.rows) do
                if r.sellIncome then exact = exact + 1 end
            end
            eggCounter = (eb and (eb[1] .. " / " .. eb[2] .. " яиц") or (#eggView.rows .. " яиц"))
                .. "  ·  точный доход: " .. exact .. "/" .. #eggView.rows
            updateCounter()
            task.wait(1)
        end
    end)
end

