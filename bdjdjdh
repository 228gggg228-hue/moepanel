local function pressButton(btn)
    -- нажимаем кнопку так, как это делает игрок: сигналы Activated / клик мыши, затем запасной вариант
    local fired = false
    pcall(function()
        if firesignal then
            firesignal(btn.Activated, Enum.UserInputType.MouseButton1, 0)
            firesignal(btn.MouseButton1Click)
            fired = true
        end
    end)
    pcall(function()
        if getconnections then
            for _, sig in ipairs({btn.Activated, btn.MouseButton1Click, btn.MouseButton1Down, btn.MouseButton1Up}) do
                for _, cn in ipairs(getconnections(sig)) do
                    pcall(function() cn:Fire() end)
                    fired = true
                end
            end
        end
    end)
    if not fired then
        pcall(function()
            local vim = game:GetService("VirtualInputManager")
            local pos = btn.AbsolutePosition + btn.AbsoluteSize / 2
            vim:SendMouseButtonEvent(pos.X, pos.Y + 58, 0, true, game, 1) -- +58: смещение верхней панели Roblox
            vim:SendMouseButtonEvent(pos.X, pos.Y + 58, 0, false, game, 1)
        end)
    end
end

local function bagInventory()
    local pg0 = LP:FindFirstChildOfClass("PlayerGui")
    local bpg0 = pg0 and pg0:FindFirstChild("BackpackGui")
    local bp0 = bpg0 and bpg0:FindFirstChild("Backpack")
    local main0 = bp0 and bp0:FindFirstChild("Main")
    return main0 and main0:FindFirstChild("Inventory")
end

local function currentBagTab(inv)
    local cap = inv and inv:FindFirstChild("Capacity")
    local txt = cap and (cap:IsA("TextButton") or cap:IsA("TextLabel")) and cap.Text or ""
    if txt:find("^Eggs") then return "Eggs" end
    if txt:find("^Pets") then return "Pets" end
    return nil
end

local openingBag = false
local function openBag(kind) -- kind: "Eggs" или "Pets"
    if openingBag then return end
    openingBag = true
    task.spawn(function()
        local ok = pcall(function()
            local pg0 = LP:FindFirstChildOfClass("PlayerGui")
            local inv = bagInventory()
            -- 1) открыть рюкзак кнопкой справа в HUD (EggsButton / PetsButton)
            if not (inv and inv.Visible) then
                local hud = pg0 and pg0:FindFirstChild("HUD")
                for _, hudName in ipairs({"GameHUD", "TradmilHud"}) do
                    local rb = hud and hud:FindFirstChild(hudName) and hud[hudName]:FindFirstChild("RightButtons")
                    local b = rb and rb:FindFirstChild(kind .. "Button")
                    if b and b.Visible then pressButton(b) end
                    local t0 = os.clock()
                    while os.clock() - t0 < 0.8 and not (bagInventory() and bagInventory().Visible) do task.wait(0.1) end
                    if bagInventory() and bagInventory().Visible then break end
                end
            end
            inv = bagInventory()
            if not inv then return end
            -- 2) переключить вкладку и проверить результат по подписи Capacity ("Eggs: .." / "Pets: ..")
            if currentBagTab(inv) ~= kind then
                local cat = inv:FindFirstChild("CategoryFrame")
                if cat then
                    for _, o in ipairs(cat:GetDescendants()) do
                        if o:IsA("GuiButton") then
                            pressButton(o)
                            task.wait(0.3)
                            if currentBagTab(inv) == kind then break end
                        end
                    end
                end
            end
        end)
        openingBag = false
    end)
end

