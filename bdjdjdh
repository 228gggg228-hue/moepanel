    local eggMode = "All" -- "1" = первый мир, "2" = Хэллоуин, "All" = оба
    local autoStealOn, halloweenOn = false, false
    local FALLBACK = {Divine = Color3.fromRGB(255, 240, 140), Secret = Color3.fromRGB(235, 235, 235), Eternal = Color3.fromRGB(80, 235, 235),
        Cosmic = Color3.fromRGB(170, 90, 255), Mythic = Color3.fromRGB(255, 80, 120), Legendary = Color3.fromRGB(255, 200, 40),
        Rare = Color3.fromRGB(70, 150, 255), Uncommon = Color3.fromRGB(90, 225, 90), Common = Color3.fromRGB(200, 200, 200)}
    local function readable(c)
        if typeof(c) ~= "Color3" then return c end
        local h, sat, val = Color3.toHSV(c)
        if val < 0.35 then return Color3.fromRGB(205, 205, 222) end
        return Color3.fromHSV(h, sat, math.max(val, 0.85))
    end
    local function rarityColor(name)
        local col
        pcall(function()
            local rdata = require(game:GetService("ReplicatedStorage").Data.Rarity)
            for k, r in pairs(rdata.Rarities or {}) do
                local dn = tostring(r.DisplayName or r._id or k)
                if dn:lower() == name:lower() and typeof(r.Color) == "Color3" then col = r.Color end
