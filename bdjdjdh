    local function addLabel(parent, text, size, z)
        local l = inst("TextLabel", {BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Text = text,
            TextScaled = true, Font = Enum.Font.GothamBlack, TextColor3 = Color3.new(1, 1, 1), ZIndex = z or 10}, parent)
        stroke(l, 1.8)
