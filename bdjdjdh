-- ========= помощники =========
local function new(class, props, parent)
    local o = Instance.new(class)
    for k, v in pairs(props) do o[k] = v end
    o.Parent = parent
    return o
end
local function corner(o, r) return new("UICorner", {CornerRadius = UDim.new(0, r)}, o) end
local function stroke(o, col, th, tr)
    return new("UIStroke", {Color = col or C.stroke, Thickness = th or 1, Transparency = tr or 0,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border}, o)
end
local function frame(parent, x, y, w, h, col, r)
    local f = new("Frame", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = col or C.panel, BorderSizePixel = 0}, parent)
    if r then corner(f, r) end
    return f
end
local function label(parent, text, x, y, w, h, size, col, font, align)
    return new("TextLabel", {
        Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
        BackgroundTransparency = 1, Text = text, TextSize = size or 16,
        TextColor3 = col or C.text, Font = font or Enum.Font.GothamMedium,
        TextXAlignment = align or Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
    }, parent)
end
local function button(parent, x, y, w, h, col, r)
    local b = new("TextButton", {Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(w, h),
        BackgroundColor3 = col, BorderSizePixel = 0, Text = "", AutoButtonColor = false}, parent)
    if r then corner(b, r) end
    return b
end
local function hover(b, normal, over)
    b.MouseEnter:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = over}):Play() end)
    b.MouseLeave:Connect(function() TweenService:Create(b, TweenInfo.new(0.12), {BackgroundColor3 = normal}):Play() end)
end

