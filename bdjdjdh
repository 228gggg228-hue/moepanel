-- доход в секунду яйца считаем игровой функцией AssetItems.SalePrice (цена = доход * 100, проверено на двух яйцах)
local AssetItemsMod
do
    local okR, m = pcall(function()
        return require(game:GetService("ReplicatedStorage").Shared.Util.AssetItems)
    end)
    if okR and type(m) == "table" then AssetItemsMod = m end
end

local function fmtIncome(n)
    if n < 100000 then
        local str = tostring(math.floor(n + 0.5))
        str = str:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        return "$" .. str .. "/s"
    end
    local suffixes = {"K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No"}
    local idx = 0
    while n >= 1000 and idx < #suffixes do n = n / 1000; idx = idx + 1 end
    local txt = string.format("%.1f", n):gsub("%.0$", "")
    return "$" .. txt .. suffixes[idx] .. "/s"
end

local function calcIncome(attrs)
    if not AssetItemsMod or type(AssetItemsMod.SalePrice) ~= "function" or not attrs then return nil end
    local muts = {}
    local raw = attrs.Mutations
    if type(raw) == "string" then
        for m in raw:gmatch("[^,]+") do
            m = m:gsub("^%s+", ""):gsub("%s+$", "")
            if m ~= "" then table.insert(muts, m) end
        end
    elseif type(raw) == "table" then
        muts = raw
    end
    local ok, price = pcall(AssetItemsMod.SalePrice, {
        Category = attrs.AssetCategory, Scale = attrs.Scale or attrs.AssetScale, Mutations = muts,
    })
    if ok and type(price) == "number" then return fmtIncome(price / 100) end
    return nil
end

