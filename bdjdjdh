    end

    -- высота строки зависит от ширины списка (как в Steal Panel)
    local function rowHeight()
        local w = panelParts and panelParts.list and panelParts.list.AbsoluteSize.X or 0
        return math.max(1, math.floor(w / ROW_RATIO + 0.5))
    end
    local function layoutRows()
        if not panelParts then return end
        local h = rowHeight()
        if h == lastRowH then return end
        lastRowH = h
        for _, r in ipairs(made) do pcall(function() r.Size = UDim2.new(1, 0, 0, h) end) end
        for _, r in ipairs(madePets) do pcall(function() r.Size = UDim2.new(1, 0, 0, h) end) end
    end
    -- обводки масштабируются вместе с шириной панели
    local function applyStrokes()
        if not (pgui and panelFrame) then return end
        local w = panelFrame.AbsoluteSize.X
        if w <= 0 then return end
