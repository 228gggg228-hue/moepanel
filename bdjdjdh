    local SECRET_SEQ = seq({{0, P(255, 255, 255)}, {0.2, P(206, 212, 224)}, {0.42, P(74, 80, 94)}, {0.58, P(42, 46, 56)},
        {0.78, P(158, 166, 182)}, {1, P(250, 252, 255)}})
    local BTN_TWEEN = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    local function applyStyle(o, st)
