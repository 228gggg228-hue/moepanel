local hiddenSwitchWorks = nil -- узнаем на практике: меняется ли вкладка, пока рюкзак закрыт
local function refreshEggBag()
    if openingBag then return end
    local inv = bagInventory()
    if not inv then return end
    if currentBagTab(inv) == "Eggs" then pollBagLabel(); return end
    if inv.Visible then return end -- ты сам смотришь рюкзак на другой вкладке: не мешаем
    openingBag = true
    pcall(function()
        local prev = currentBagTab(inv) or "Pets"
        -- 1) попытка без открытия: просто переключить вкладку у закрытого рюкзака
        if hiddenSwitchWorks ~= false then
            local okSwitch = selectBagTab(inv, "Eggs")
            hiddenSwitchWorks = okSwitch
            if okSwitch then
                pollBagLabel()
                selectBagTab(inv, prev)
                return
            end
            selectBagTab(inv, prev) -- не вышло: вернуть вкладку, какой она была
        end
        -- 2) запасной путь: открыть рюкзак, но увести окно за пределы экрана, чтобы ничего не мигало
        local origPos = inv.Position
        local okOpen = pcall(function()
            inv.Position = UDim2.new(0, -6000, 0, -6000)
            local pg0 = LP:FindFirstChildOfClass("PlayerGui")
            local hud = pg0 and pg0:FindFirstChild("HUD")
            for _, hudName in ipairs({"GameHUD", "TradmilHud"}) do
                local rb = hud and hud:FindFirstChild(hudName) and hud[hudName]:FindFirstChild("RightButtons")
                local b = rb and rb:FindFirstChild("EggsButton")
                if b and b.Visible then pressButton(b) end
                local t0 = os.clock()
                while os.clock() - t0 < 0.8 and not inv.Visible do task.wait(0.1) end
                if inv.Visible then break end
            end
            if inv.Visible then
                if selectBagTab(inv, "Eggs") then pollBagLabel() end
                selectBagTab(inv, prev)
                -- закрыть: кнопка Close, потом повторное нажатие HUD-кнопки, потом принудительно
                local closeBtn = inv:FindFirstChild("Close")
                if closeBtn and closeBtn:IsA("GuiButton") then pressButton(closeBtn); task.wait(0.3) end
                if inv.Visible then
